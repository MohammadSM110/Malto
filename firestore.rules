rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Global Helper Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // -------------------------------------------------------------------------
    // User Profiles
    // -------------------------------------------------------------------------
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 100 &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             data.district is string && data.district.size() >= 2 && data.district.size() <= 60 &&
             (!('city' in data) || (data.city is string && data.city.size() <= 50)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
             (!('donatedCount' in data) || data.donatedCount is number) &&
             (!('receivedCount' in data) || data.receivedCount is number);
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().uid == request.auth.uid &&
                       isValidUser(incoming());
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().uid == existing().uid &&
                       isValidUser(incoming());
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // 100% Free Giveaway Items
    // Non-commercial rules: strictly no price, buying, or selling fields.
    // -------------------------------------------------------------------------
    function isValidGiveawayItem(data) {
      return !(data.keys().hasAny(['price', 'cost', 'fee', 'currency', 'payment', 'sellingPrice', 'buyNow'])) &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
             data.description is string && data.description.size() >= 5 && data.description.size() <= 2000 &&
             data.category is string && data.category.size() <= 50 &&
             data.condition in ['کاملاً نو', 'در حد نو', 'سالم', 'نیازمند تعمیر'] &&
             data.city is string && data.city.size() <= 50 &&
             data.district is string && data.district.size() <= 50 &&
             data.imageUrl is string && data.imageUrl.size() <= 1000000 &&
             data.donorId is string && data.donorId.size() <= 128 &&
             data.donorName is string && data.donorName.size() <= 100 &&
             data.status in ['available', 'reserved', 'given'] &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('images' in data) || (data.images is list && data.images.size() <= 10)) &&
             (!('viewsCount' in data) || data.viewsCount is number) &&
             (!('requestsCount' in data) || data.requestsCount is number) &&
             (!('urgentPickup' in data) || data.urgentPickup is bool) &&
             (!('pickupAddress' in data) || (data.pickupAddress is string && data.pickupAddress.size() <= 300));
    }

    match /items/{itemId} {
      // Free giveaway catalog is publicly viewable
      allow get: if true;
      allow list: if true;

      // Only signed-in users can list items as donors
      allow create: if isSignedIn() &&
                       isValidId(itemId) &&
                       incoming().donorId == request.auth.uid &&
                       isValidGiveawayItem(incoming());

      // Donor can update item details; any user (guest or authenticated) can bump view counter
      allow update: if isValidId(itemId) &&
                       (
                         // View counter tracking (accessible to all visitors)
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount']) &&
                           incoming().viewsCount is number &&
                           incoming().viewsCount >= existing().viewsCount
                         ) ||
                         // Requests counter increment or donor edits (requires authentication)
                         (
                           isSignedIn() &&
                           (
                             (
                               existing().donorId == request.auth.uid &&
                               incoming().donorId == existing().donorId &&
                               incoming().createdAt == existing().createdAt &&
                               isValidGiveawayItem(incoming())
                             ) ||
                             (
                               incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount', 'requestsCount'])
                             )
                           )
                         )
                       );

      // Only the donor can remove the item
      allow delete: if isSignedIn() &&
                       isValidId(itemId) &&
                       existing().donorId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Item Requests / Claims
    // -------------------------------------------------------------------------
    function isValidItemRequest(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.itemId is string && data.itemId.size() <= 128 &&
             data.itemTitle is string && data.itemTitle.size() <= 120 &&
             data.requesterId is string && data.requesterId.size() <= 128 &&
             data.donorId is string && data.donorId.size() <= 128 &&
             data.message is string && data.message.size() <= 1000 &&
             data.status in ['pending', 'accepted', 'declined', 'completed'] &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('pickupOption' in data) || (data.pickupOption in ['pickup', 'courier', 'any'])) &&
             (!('itemImageUrl' in data) || (data.itemImageUrl is string && data.itemImageUrl.size() <= 1000000));
    }

    match /requests/{requestId} {
      // Requesters can see their own requests; donors can see requests for their items
      allow get: if isSignedIn() &&
                    (resource.data.requesterId == request.auth.uid || resource.data.donorId == request.auth.uid);

      allow list: if isSignedIn() &&
                     (resource.data.requesterId == request.auth.uid || resource.data.donorId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(requestId) &&
                       incoming().requesterId == request.auth.uid &&
                       isValidItemRequest(incoming());

      // Donor can accept/decline; Requester can update message or cancel
      allow update: if isSignedIn() &&
                       isValidId(requestId) &&
                       (
                         (
                           resource.data.donorId == request.auth.uid &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                           incoming().status in ['accepted', 'declined', 'completed']
                         ) ||
                         (
                           resource.data.requesterId == request.auth.uid &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'message', 'updatedAt'])
                         )
                       );

      allow delete: if isSignedIn() &&
                       isValidId(requestId) &&
                       resource.data.requesterId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // In-App Notifications
    // -------------------------------------------------------------------------
    function isValidNotification(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.type in ['new_request', 'request_accepted', 'request_declined', 'item_comment'] &&
             data.title is string && data.title.size() <= 120 &&
             data.body is string && data.body.size() <= 500 &&
             data.read is bool &&
             data.createdAt is string && data.createdAt.size() <= 50;
    }

    match /notifications/{notificationId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(notificationId) &&
                       isValidNotification(incoming());
      allow update: if isSignedIn() &&
                       resource.data.userId == request.auth.uid &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Taxonomy: Categories & Locations (Read-only for users)
    // -------------------------------------------------------------------------
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /locations/{locationId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
